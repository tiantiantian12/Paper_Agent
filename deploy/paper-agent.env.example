# Paper Agent Server 运行时配置（systemd EnvironmentFile）
#
# 复制到 /etc/paper-agent/paper-agent.env 后使用（deploy/install.sh 会自动做，
# 并顺手生成一个随机看板口令）。权限必须是 600：这里面全是机密。
#
# 优先级：环境变量 > config.json > 代码默认值（见 app/config.py）
#
# ⚠️ 别把本文件（填好密钥的那一份）提交到仓库。

# ------------------------------------------------------------------ 监听地址
# 阶段一（没有域名，用 IP 直连验证）：
#   API_HOST=0.0.0.0  —— 让桌面端能从公网连上；
#   同时必须在【轻量应用服务器控制台 → 防火墙】里把 8000 只对**你自己的公网 IP** 放通，
#   验证完立刻删掉那条规则。
# 阶段二（域名 + HTTPS）：跑 deploy/enable-https.sh 会自动把这里改回 127.0.0.1，
#   之后 8000 不再需要对外放通（只留 80 / 443）。
API_HOST=0.0.0.0
API_PORT=8000

# 看板永远只监听本机：要看时用 SSH 隧道
#   ssh -L 8010:127.0.0.1:8010 root@<服务器IP>   然后浏览器开 http://127.0.0.1:8010
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8010

# ------------------------------------------------------------------ 看板口令
# 置空 = 免口令校验，**公网上绝对不要留空**。
# install.sh 首次生成时会把 __ADMIN_TOKEN__ 换成一个随机口令并打印出来。
ADMIN_ACCESS_TOKEN=__ADMIN_TOKEN__

# ------------------------------------------------------------------ 账号
# 生产环境设为 false：校验只用 PBKDF2 哈希，别额外存一份明文给看板展示
STORE_PLAIN_PASSWORD=false
# 登录令牌有效期（天），默认 30
# TOKEN_TTL_DAYS=30
# 允许注册的邮箱后缀，逗号分隔；留空不限制（注册接口本身已要求 QQ 邮箱）
# ALLOWED_EMAIL_DOMAINS=

# ------------------------------------------------------------------ QQ 邮箱 SMTP（发验证码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SENDER=你的发件QQ邮箱@qq.com
# QQ 邮箱 → 设置 → 账户 → POP3/SMTP 服务 → 生成授权码（不是登录密码）
SMTP_PASSWORD=QQ邮箱的SMTP授权码
# 本地联调想不真发信：置 true，验证码会打进 journalctl -u paper-agent-api
# SMTP_DRY_RUN=false

# ------------------------------------------------------------------ 请求日志
# 阶段二挂了 Caddy 之后必须设 true，否则看板里所有来源都是 127.0.0.1；
# 阶段一（IP 直连、没有反代）保持 false —— 那时 TCP 对端就是真实来源。
LOG_TRUST_PROXY=false
# LOG_RETENTION_DAYS=14
# LOG_MAX_ROWS=200000

# ------------------------------------------------------------------ 大模型代理
# 供应商密钥池命中限流后的冷却秒数；单次代理最多试几把 Key
# PROVIDER_COOLDOWN_SECONDS=60
# PROXY_MAX_KEY_TRIES=3
# 转发到供应商的读超时（秒）。流式对话是长连接，别小于 120
# PROXY_READ_TIMEOUT=600
# 新账号代理密钥的有效天数；0 表示不过期
# USER_KEY_TTL_DAYS=30

# ------------------------------------------------------------------ 数据目录
# 默认就是 <项目目录>/data（SQLite：paper_agent.db，WAL 模式）
# PAPER_AGENT_SERVER_DATA=/opt/paper-agent-server/data

# ------------------------------------------------------------------ 注意
# 内置模型与供应商密钥**不要**写在这里：环境变量 LLM_MODELS 传的是字符串，
# 代码只认 config.json 里的列表（app/config.py 的 _llm_models），
# 所以模型 / 密钥要么写在 config.json 的 llm.models（启动时幂等播种），
# 要么登录看板手工添加。
